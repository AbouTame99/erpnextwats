    "fields": [
        {
            "fieldname": "template_name",
            "fieldtype": "Data",
            "label": "Template Name",
            "reqd": 1,
            "unique": 1
        },
        {
            "fieldname": "doctype_name",
            "fieldtype": "Link",
            "label": "Source DocType",
            "options": "DocType",
            "reqd": 1
        },
        {
            "fieldname": "message_section",
            "fieldtype": "Section Break",
            "label": "Message Content"
        },
        {
            "description": "You can use Jinja variables like {{ doc.customer_name }}",
            "fieldname": "message",
            "fieldtype": "Small Text",
            "label": "Message",
            "reqd": 1
        },
        {
            "fieldname": "preview_section",
            "fieldtype": "Section Break",
            "label": "Live Preview"
        },
        {
            "fieldname": "preview_doc",
            "fieldtype": "Dynamic Link",
            "label": "Reference Document",
            "options": "doctype_name"
        },
        {
            "fieldname": "preview_html",
            "fieldtype": "HTML",
            "label": "Rendered Preview"
        },
        {
            "fieldname": "attachment_section",
            "fieldtype": "Section Break",
            "label": "Attachments"
        },
        {
            "default": "0",
            "fieldname": "attach_pdf",
            "fieldtype": "Check",
            "label": "Attach Document PDF"
        },
        {
            "fieldname": "custom_media",
            "fieldtype": "Attach",
            "label": "Custom Media/Image"
        },
        {
            "fieldname": "auto_send_section",
            "fieldtype": "Section Break",
            "label": "Auto Send Settings"
        },
        {
            "default": "0",
            "fieldname": "enable_auto_send",
            "fieldtype": "Check",
            "label": "Enable Auto Send"
        },
        {
            "depends_on": "enable_auto_send",
            "fieldname": "auto_send_mode",
            "fieldtype": "Select",
            "label": "Send Mode",
            "options": "\nOn Submit\nOn Status Change\nMonitor Documents\nRecurring\nDead Stock Marketing",
            "description": "On Submit = Send when document is submitted. On Status Change = Send when status changes. Monitor Documents = Periodically check submitted docs. Recurring = Send to selected customers. Dead Stock Marketing = Daily sends of slow-moving items to all customers."
        },
        {
            "fieldname": "column_break_1",
            "fieldtype": "Column Break"
        },
        {
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Recurring'",
            "fieldname": "auto_send_frequency",
            "fieldtype": "Select",
            "label": "Frequency",
            "options": "Weekly\nMonthly",
            "description": "How often to send to selected customers"
        },
        {
            "fieldname": "selected_customers_section",
            "fieldtype": "Section Break",
            "label": "Selected Customers",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Recurring'"
        },
        {
            "fieldname": "selected_customers",
            "fieldtype": "Table",
            "label": "Customers to Send To",
            "options": "WhatsApp Template Customer",
            "description": "Select customers who will receive this message automatically"
        },
        {
            "fieldname": "conditions_section",
            "fieldtype": "Section Break",
            "label": "When to Send (Conditions)",
            "depends_on": "eval:doc.enable_auto_send && (doc.auto_send_mode == 'On Submit' || doc.auto_send_mode == 'On Status Change' || doc.auto_send_mode == 'Monitor Documents')"
        },
        {
            "fieldname": "trigger_status",
            "fieldtype": "Small Text",
            "label": "Trigger When Status Is",
            "options": "",
            "description": "Select the status that triggers auto-send. You can select multiple for Monitor Documents mode.",
            "depends_on": "eval:doc.enable_auto_send && (doc.auto_send_mode == 'On Status Change' || doc.auto_send_mode == 'Monitor Documents')"
        },
        {
            "fieldname": "monitoring_frequency",
            "fieldtype": "Select",
            "label": "Check Frequency",
            "options": "\nHourly\nDaily\nWeekly\nCustomize",
            "default": "Daily",
            "description": "How often to check submitted documents for condition changes",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Monitor Documents'"
        },
        {
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Monitor Documents' && doc.monitoring_frequency == 'Customize'",
            "fieldname": "custom_monitoring_interval",
            "fieldtype": "Int",
            "label": "Interval (Days)",
            "default": "1",
            "description": "Check documents every X days"
        },
        {
            "fieldname": "dead_stock_section",
            "fieldtype": "Section Break",
            "label": "Dead Stock Marketing Settings",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "items_per_day",
            "fieldtype": "Int",
            "label": "Items Per Day",
            "default": "5",
            "description": "How many dead stock items to send each day",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "dead_stock_warehouse",
            "fieldtype": "Link",
            "label": "Warehouse",
            "options": "Warehouse",
            "default": "JTL - JT",
            "description": "Only send items from this warehouse",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "min_days_stagnant",
            "fieldtype": "Int",
            "label": "Min Days Without Sales",
            "default": "120",
            "description": "Only items not sold for X days or more",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "column_break_ds1",
            "fieldtype": "Column Break",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "send_time",
            "fieldtype": "Time",
            "label": "Send Time",
            "default": "11:00:00",
            "description": "Time of day to send (24h format)",
            "depends_on": "eval:doc.enable_auto_send && (doc.auto_send_mode == 'Dead Stock Marketing' || doc.auto_send_mode == 'Monitor Documents')"
        },
        {
            "fieldname": "include_item_images",
            "fieldtype": "Check",
            "label": "Include Item Images",
            "default": "1",
            "description": "Attach product images if available (only works with 'Each Item Separately')",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "dead_stock_send_style",
            "fieldtype": "Select",
            "label": "Send Style",
            "options": "Each Item Separately\nAll Items in One Message\nAll Items (Individual Bubbles)",
            "default": "Each Item Separately",
            "description": "'Each Item Separately' = one message per item. 'All Items in One Message' = single combined message. 'All Items (Individual Bubbles)' = sequential Greeting -> [Image + Item] x N -> Footer.",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "dead_stock_preview_section",
            "fieldtype": "Section Break",
            "label": "Dead Stock Preview",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Dead Stock Marketing'"
        },
        {
            "fieldname": "preview_dead_stock_btn",
            "fieldtype": "Button",
            "label": "Preview Today's Dead Stock Items"
        },
        {
            "fieldname": "dead_stock_preview_html",
            "fieldtype": "HTML",
            "label": "Dead Stock Items Preview"
        },
        {
            "fieldname": "dead_stock_tracking_section",
            "fieldtype": "Section Break",
            "label": "Campaign Tracking (Auto-populated)"
        },
        {
            "fieldname": "last_sent_index",
            "fieldtype": "Int",
            "label": "Last Sent Index",
            "read_only": 1,
            "description": "Position in dead stock list (auto-updated)"
        },
        {
            "fieldname": "total_items_pool",
            "fieldtype": "Int",
            "label": "Total Items in Pool",
            "read_only": 1,
            "description": "Total dead stock items available"
        },
        {
            "fieldname": "column_break_ds2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "cycle_count",
            "fieldtype": "Int",
            "label": "Cycles Completed",
            "read_only": 1,
            "description": "How many full cycles completed"
        },
        {
            "fieldname": "last_send_date",
            "fieldtype": "Date",
            "label": "Last Send Date",
            "read_only": 1
        },
        {
            "fieldname": "last_monitoring_run",
            "fieldtype": "Datetime",
            "label": "Last Monitoring Run",
            "read_only": 1
        },
        {
            "fieldname": "visual_conditions",
            "fieldtype": "JSON",
            "label": "Filter Conditions (JSON)",
            "description": "Define filters like: outstanding_amount > 0, grand_total > 1000, etc."
        },
        {
            "fieldname": "conditions_preview_html",
            "fieldtype": "HTML",
            "label": "Conditions Preview",
            "depends_on": "eval:doc.enable_auto_send && doc.visual_conditions"
        },
        {
            "fieldname": "matching_docs_preview",
            "fieldtype": "HTML",
            "label": "Matching Documents"
        },
        {
            "fieldname": "condition_examples_section",
            "fieldtype": "Section Break",
            "label": "Filter Examples",
            "depends_on": "eval:doc.enable_auto_send && (doc.auto_send_mode == 'On Submit' || doc.auto_send_mode == 'On Status Change' || doc.auto_send_mode == 'Monitor Documents')"
        },
        {
            "fieldname": "anti_ban_section",
            "fieldtype": "Section Break",
            "label": "Anti-Ban Protection"
        },
        {
            "default": "50",
            "fieldname": "hourly_limit",
            "fieldtype": "Int",
            "label": "Hourly Limit",
            "description": "Maximum messages per hour"
        },
        {
            "default": "500",
            "fieldname": "daily_limit",
            "fieldtype": "Int",
            "label": "Daily Limit"
        },
        {
            "fieldname": "column_break_2",
            "fieldtype": "Column Break"
        },
        {
            "default": "24",
            "fieldname": "cooldown_hours",
            "fieldtype": "Int",
            "label": "Cooldown (Hours)",
            "description": "Minimum hours between sends to same customer"
        },
        {
            "default": "5",
            "fieldname": "max_per_customer",
            "fieldtype": "Int",
            "label": "Max Per Customer/Day",
            "description": "Maximum messages per customer per day"
        }
    ],
    "index_web_pages_for_search": 1,
