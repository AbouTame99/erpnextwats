            "label": "Custom Media/Image"
        },
        {
            "fieldname": "auto_send_section",
            "fieldtype": "Section Break",
            "label": "Auto Send Settings"
        },
        {
            "default": "0",
            "fieldname": "enable_auto_send",
            "fieldtype": "Check",
            "label": "Enable Auto Send"
        },
        {
            "depends_on": "enable_auto_send",
            "fieldname": "auto_send_mode",
            "fieldtype": "Select",
            "label": "Send Mode",
            "options": "\nRecurring\nOn Document Create",
            "description": "Recurring = Send periodically to selected customers. On Document Create = Send when new document is created."
        },
        {
            "fieldname": "column_break_1",
            "fieldtype": "Column Break"
        },
        {
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Recurring'",
            "fieldname": "auto_send_frequency",
            "fieldtype": "Select",
            "label": "Frequency",
            "options": "Weekly\nMonthly",
            "description": "How often to send to selected customers"
        },
        {
            "fieldname": "selected_customers_section",
            "fieldtype": "Section Break",
            "label": "Selected Customers",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'Recurring'"
        },
        {
            "fieldname": "selected_customers",
            "fieldtype": "Table",
            "label": "Customers to Send To",
            "options": "WhatsApp Template Customer",
            "description": "Select customers who will receive this message automatically"
        },
        {
            "fieldname": "conditions_section",
            "fieldtype": "Section Break",
            "label": "When to Send (Conditions)",
            "depends_on": "eval:doc.enable_auto_send && doc.auto_send_mode == 'On Document Create'"
        },
        {
            "fieldname": "visual_conditions",
            "fieldtype": "JSON",
            "label": "Conditions",
            "description": "Define when to send (e.g., when Invoice amount > 1000)"
        },
        {
            "fieldname": "preview_conditions_btn",
            "fieldtype": "Button",
            "label": "Preview Matching Documents"
        },
        {
            "fieldname": "matching_docs_preview",
            "fieldtype": "HTML",
            "label": "Matching Documents"
        },
        {
            "fieldname": "anti_ban_section",
            "fieldtype": "Section Break",
            "label": "Anti-Ban Protection"
        },
        {
            "default": "50",
            "fieldname": "hourly_limit",
            "fieldtype": "Int",
            "label": "Hourly Limit",
            "description": "Maximum messages per hour"
        },
        {
            "default": "500",
            "fieldname": "daily_limit",
            "fieldtype": "Int",
            "label": "Daily Limit"
        },
        {
            "fieldname": "column_break_2",
            "fieldtype": "Column Break"
        },
        {
            "default": "24",
            "fieldname": "cooldown_hours",
            "fieldtype": "Int",
            "label": "Cooldown (Hours)",
            "description": "Minimum hours between sends to same customer"
        },
        {
            "default": "5",
            "fieldname": "max_per_customer",
            "fieldtype": "Int",
            "label": "Max Per Customer/Day",
            "description": "Maximum messages per customer per day"
        }
